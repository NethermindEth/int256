diff --git a/src/Nethermind.Int256/UInt256.zkevm.cs b/src/Nethermind.Int256/UInt256.zkevm.cs
index f1c7684..c3de1ff 100644
--- a/src/Nethermind.Int256/UInt256.zkevm.cs
+++ b/src/Nethermind.Int256/UInt256.zkevm.cs
@@ -280,5 +280,25 @@ public readonly partial struct UInt256
 
     [MethodImpl(MethodImplOptions.AggressiveInlining)]
     private static partial void Remainder256ByFullModulus(in UInt256 x, in UInt256 y, out UInt256 res)
-        => Remainder256By256(in x, in y, out res);
+    {
+        if (y.u3 >> 52 == Bn254R.Top >> 52)
+        {
+            Remainder256ByTopLimb12(in x, in y, out res);
+            return;
+        }
+
+        Remainder256By256(in x, in y, out res);
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static void Remainder256ByTopLimb12(in UInt256 x, in UInt256 y, out UInt256 res)
+    {
+        if (y.u3 == Bn254R.Top)
+        {
+            Remainder256ByTopLimb254(in x, in y, out res);
+            return;
+        }
+
+        Remainder256By256(in x, in y, out res);
+    }
