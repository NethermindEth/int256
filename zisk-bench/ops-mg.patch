diff --git a/src/Nethermind.Int256/UInt256.divmod.cs b/src/Nethermind.Int256/UInt256.divmod.cs
index dcce9a0..f22792b 100644
--- a/src/Nethermind.Int256/UInt256.divmod.cs
+++ b/src/Nethermind.Int256/UInt256.divmod.cs
@@ -1812,7 +1812,10 @@ public readonly partial struct UInt256
 
         ulong r1 = ul - (q * d);
 
-        if (r1 > low) { q--; r1 += d; }
+        // The first correction happens for about half of all digits, so a branch on it mispredicts.
+        ulong mask = 0UL - (r1 > low ? 1UL : 0UL);
+        q += mask;
+        r1 += d & mask;
         if (r1 >= d) { q++; r1 -= d; }
 
