import UInt256.Methods.Storage@storage@
import Extracted
import UInt256.Methods.Shift.ScalarOperator

namespace UInt256Proof.Operator@short@

theorem @family@_correctness : UInt256Model.Safety.ReadOnlyScalarContract CIL.Value.i32
    (fun input count => .aggregate (CIL.Safety.numberBytes (UInt256Proof.Shift.result .@direction@ input count).toNat 32))
    Extracted.program 0 :=
  UInt256Proof.Shift.Safety.operator_correctness Extracted.profile .@direction@ Extracted.program 0 1 (by rfl)
    (UInt256Proof.Shift.Safety.wrapper_correctness Extracted.profile .@direction@ Extracted.program 1 2 (by rfl)
      (UInt256Proof.Shift.Safety.scalar_correctness (profile := Extracted.profile) (direction := .@direction@)
        (storage := 3) (by rfl) (UInt256Proof.Storage@storage@.store_limbs_readable_contract Extracted.profile (by rfl) _ _ (by rfl))))

theorem @family@_family_correctness (profile : CIL.FeatureProfile)
    (storageProfile : profile.vector256Accelerated = @accelerated@) : UInt256Model.Safety.ReadOnlyScalarContract CIL.Value.i32
    (fun input count => .aggregate (CIL.Safety.numberBytes (UInt256Proof.Shift.result .@direction@ input count).toNat 32))
    (CIL.reprofile Extracted.program profile) 0 :=
  UInt256Proof.Shift.Safety.operator_correctness profile .@direction@ (CIL.reprofile Extracted.program profile) 0 1 (by rfl)
    (UInt256Proof.Shift.Safety.wrapper_correctness profile .@direction@ (CIL.reprofile Extracted.program profile) 1 2 (by rfl)
      (UInt256Proof.Shift.Safety.scalar_correctness (profile := profile) (direction := .@direction@)
        (storage := 3) (by rfl) (UInt256Proof.Storage@storage@.store_limbs_readable_contract profile storageProfile _ _ (by rfl))))


end UInt256Proof.Operator@short@
