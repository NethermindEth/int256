import UInt256.Methods.Storage@storage@
import Extracted
import UInt256.Methods.Shift.ScalarContract

namespace UInt256Proof.@short@

theorem @family@_correctness : UInt256Model.Safety.ShiftContract .@direction@ Extracted.program 0 :=
  UInt256Proof.Shift.Safety.scalar_correctness (profile := Extracted.profile) (direction := .@direction@)
    (storage := 1) (by rfl) (UInt256Proof.Storage@storage@.store_limbs_readable_contract Extracted.profile (by rfl) _ _ (by rfl))

theorem @family@_family_correctness (profile : CIL.FeatureProfile)
    (storageProfile : profile.vector256Accelerated = @accelerated@) : UInt256Model.Safety.ShiftContract .@direction@ (CIL.reprofile Extracted.program profile) 0 :=
  UInt256Proof.Shift.Safety.scalar_correctness (profile := profile) (direction := .@direction@)
    (storage := 1) (by rfl) (UInt256Proof.Storage@storage@.store_limbs_readable_contract profile storageProfile _ _ (by rfl))


end UInt256Proof.@short@
