theorem lanes_body_shaped (profile : CIL.FeatureProfile) (carry storage : Nat) :
    Shaped (lanesBody profile carry storage) inlineMergeLayout := by
  constructor <;> exact at_of_eq (Nat.le_of_ble_eq_true rfl) rfl

/-- The permuted-home AddVector128 body meets the helper contract. -/
theorem lanes_helper_contract (program : CIL.Program) (profile : CIL.FeatureProfile) (method carry storage : Nat)
    (found : program[method]? = some (lanesBody profile carry storage))
    (carryFound : program[carry]? = some (carryBody profile))
    (storageFound : program[storage]? = some (UInt256Proof.Multiply.LimbStorage.body profile))
    (disabled : profile.advSimd = false) (sse2 : profile.sse2 = true) (ssse3 : profile.ssse3 = true) :
    SSEHelperContract program method :=
  shaped_helper_contract program _ method armSpecs found inlineMergeLayout (lanes_body_shaped profile carry storage)
    (lanes_start program _ method armSpecs found _ rfl (fun i => armSpecs_first ⟨i.val, by omega⟩))
    (call_repair program _ method armSpecs found _ carry storage false (at_of_eq (Nat.le_of_ble_eq_true rfl) rfl)
      carryFound storageFound armSpecs_words rfl)
    armSpecs_first sse2 ssse3 disabled (fun _ placed => by cases placed) rfl ⟨rfl, rfl⟩ rfl rfl

#print axioms lanes_body_shaped
#print axioms lanes_helper_contract
end UInt256Proof.Add.SSEShapes
