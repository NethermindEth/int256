/-- Segment positions of `extractedHelperBody`. -/
def extractedHelperLayout (merge : Nat) : Layout :=
  { incomingDoubled := false, incoming := 49, earlyDoubled := false, propagation := 81, decisionDoubled := false,
    combine := 97, merge := some merge, join := 105, fast := 203, repairDoubled := false, repair := 161 }

theorem extracted_helper_shaped (profile : CIL.FeatureProfile) (carry merge storage : Nat) :
    Shaped (extractedHelperBody profile carry merge storage) (extractedHelperLayout merge) := by
  constructor <;> exact at_of_eq (Nat.le_of_ble_eq_true rfl) rfl

/-- The merge-helper AddVector128 body meets the helper contract. -/
theorem extracted_helper_contract (program : CIL.Program) (profile : CIL.FeatureProfile) (method carry merge storage : Nat)
    (found : program[method]? = some (extractedHelperBody profile carry merge storage))
    (carryFound : program[carry]? = some (carryBody profile))
    (mergeFound : program[merge]? = some (mergeBody profile))
    (storageFound : program[storage]? = some (UInt256Proof.Multiply.LimbStorage.body profile))
    (disabled : profile.advSimd = false) (sse2 : profile.sse2 = true) (ssse3 : profile.ssse3 = true) :
    SSEHelperContract program method :=
  carry_helper_contract program _ method carry storage found (extractedHelperLayout merge)
    (extracted_helper_shaped profile carry merge storage) rfl (at_of_eq (Nat.le_of_ble_eq_true rfl) rfl) carryFound storageFound
    sse2 ssse3 disabled (fun _ placed => by cases placed; exact mergeFound) rfl ⟨rfl, rfl⟩ rfl rfl

#print axioms extracted_helper_shaped
#print axioms extracted_helper_contract
end UInt256Proof.Add.SSEShapes
