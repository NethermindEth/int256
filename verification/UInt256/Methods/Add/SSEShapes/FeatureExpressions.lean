/-- Segment positions of `featureVectorBody`. -/
def featureLayout : Layout :=
  { incomingDoubled := true, incoming := 52, earlyDoubled := true, propagation := 86, decisionDoubled := false,
    combine := 102, merge := none, join := 110, fast := 210, repairDoubled := true, repair := 168 }

theorem feature_vector_shaped (profile : CIL.FeatureProfile) (carry storage : Nat) :
    Shaped (featureVectorBody profile carry storage) featureLayout := by
  constructor <;> exact at_of_eq (Nat.le_of_ble_eq_true rfl) rfl

/-- The doubled-guard AddVector128 body meets the helper contract. -/
theorem feature_helper_contract (program : CIL.Program) (profile : CIL.FeatureProfile) (method carry storage : Nat)
    (found : program[method]? = some (featureVectorBody profile carry storage))
    (carryFound : program[carry]? = some (carryBody profile))
    (storageFound : program[storage]? = some (UInt256Proof.Multiply.LimbStorage.body profile))
    (disabled : profile.advSimd = false) (sse2 : profile.sse2 = true) (ssse3 : profile.ssse3 = true) :
    SSEHelperContract program method :=
  carry_helper_contract program _ method carry storage found featureLayout
    (feature_vector_shaped profile carry storage) rfl (at_of_eq (Nat.le_of_ble_eq_true rfl) rfl) carryFound storageFound
    sse2 ssse3 disabled (fun _ placed => by cases placed) rfl ⟨rfl, rfl⟩ rfl rfl

/-- Word homes of `featureScalarBody`. -/
def featureScalarSpecs : List (Option (BitVec 64)) := List.replicate 7 (some 0) ++ [none, some 0]

theorem feature_scalar_shaped (profile : CIL.FeatureProfile) (vector small : Nat) :
    ScalarShaped (featureScalarBody profile vector small) 43 vector small true featureScalarSpecs :=
  ⟨rfl, at_of_eq (Nat.le_of_ble_eq_true rfl) rfl, rfl, ⟨rfl, rfl⟩, rfl, rfl, fun swapped => by cases swapped <;> rfl⟩

/-- The doubled-guard small helper meets the small-operand contract. -/
theorem shifted_small_contract (program : CIL.Program) (profile : CIL.FeatureProfile) (small storage : Nat)
    (smallFound : program[small]? = some (shiftedSmallBody profile storage))
    (storageFound : program[storage]? = some (UInt256Proof.Multiply.LimbStorage.body profile))
    (disabled : profile.advSimd = false) : PortableSmallContract program small :=
  fun memory input output word call =>
    checked_shifted_small_contract program small storage profile smallFound storageFound disabled memory input output word call

/-- SSE4.2 Add through the doubled-guard entry and a shaped scalar dispatcher, given helper contracts. -/
theorem checked_doubled_add (program : CIL.Program) (entry scalar vector small base : Nat) (doubled : Bool)
    (specs : List (Option (BitVec 64))) (profile : CIL.FeatureProfile) (body : CIL.Method)
    (noAvx2 : profile.avx2 = false)
    (entryFound : program[entry]? = some (doubledScalarBody profile scalar))
    (scalarFound : program[scalar]? = some body) (shaped : ScalarShaped body base vector small doubled specs)
    (disabled : body.profile.advSimd = false) (sse42 : body.profile.sse42 = true)
    (helper : SSEHelperContract program vector) (smallContract : PortableSmallContract program small) :
    WrappingBinaryContract (· + ·) program entry := by
  apply doubled_add_contract_of_scalar program entry scalar profile entryFound noAvx2
  intro memory left right output call
  simpa only [vector128Arguments, binaryArguments, List.cons_append, List.nil_append] using
    checked_scalar_contract program body scalar base vector small doubled specs scalarFound shaped helper smallContract
      disabled sse42 memory left right output 0 rfl call

