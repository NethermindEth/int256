/-- Fourteen vector homes, nine word homes (carry, four sum pairs), four vector homes. -/
def inlineSpecs : List NumericLocalSpec :=
  List.replicate 14 vector128ZeroSpec ++ List.replicate 9 armWordSpec ++ List.replicate 4 vector128ZeroSpec

theorem inlineSpecs_first : ∀ i : Fin 14, inlineSpecs[i.val]? = some vector128ZeroSpec := by
  intro i
  have cases : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 ∨ i = 8 ∨ i = 9 ∨ i = 10 ∨ i = 11 ∨ i = 12 ∨ i = 13 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl

theorem inlineSpecs_words : ∀ k : Fin 9, inlineSpecs[14 + k.val]? = some armWordSpec := by
  intro k
  have cases : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl

/-- Segment positions of `inlineCarryBody`. -/
def inlineCarryLayout : Layout := { inlineMergeLayout with fast := 260 }

theorem inline_carry_shaped (profile : CIL.FeatureProfile) (storage : Nat) :
    Shaped (inlineCarryBody profile storage) inlineCarryLayout := by
  constructor <;> exact at_of_eq (Nat.le_of_ble_eq_true rfl) rfl

/-- The inline-carry AddVector128 body meets the helper contract. -/
theorem inline_carry_helper_contract (program : CIL.Program) (profile : CIL.FeatureProfile) (method storage : Nat)
    (found : program[method]? = some (inlineCarryBody profile storage))
    (storageFound : program[storage]? = some (UInt256Proof.Multiply.LimbStorage.body profile))
    (disabled : profile.advSimd = false) (sse2 : profile.sse2 = true) (ssse3 : profile.ssse3 = true) :
    SSEHelperContract program method :=
  shaped_helper_contract program _ method inlineSpecs found inlineCarryLayout (inline_carry_shaped profile storage)
    (prefix_start program _ method inlineSpecs found _ rfl (fun i => inlineSpecs_first ⟨i.val, by omega⟩))
    (inline_repair program _ method inlineSpecs found _ storage (at_of_eq (Nat.le_of_ble_eq_true rfl) rfl)
      storageFound inlineSpecs_words rfl)
    inlineSpecs_first sse2 ssse3 disabled (fun _ placed => by cases placed) rfl ⟨rfl, rfl⟩ rfl rfl

/-- Word homes of `inlineCarryScalarBody`. -/
def inlineScalarSpecs : List (Option (BitVec 64)) := List.replicate 11 (some 0) ++ [none, some 0]

theorem inline_carry_scalar_shaped (profile : CIL.FeatureProfile) (vector small : Nat) :
    ScalarShaped (inlineCarryScalarBody profile vector small) 41 vector small false inlineScalarSpecs :=
  ⟨rfl, at_of_eq (Nat.le_of_ble_eq_true rfl) rfl, rfl, ⟨rfl, rfl⟩, rfl, rfl, fun swapped => by cases swapped <;> rfl⟩

/-- SSE4.2 Add through the public entry and a shaped scalar dispatcher, given helper contracts. -/
theorem checked_scalar_add (program : CIL.Program) (entry scalar vector small base : Nat) (doubled : Bool)
    (specs : List (Option (BitVec 64))) (profile : CIL.FeatureProfile) (body : CIL.Method)
    (noAvx2 : profile.avx2 = false)
    (entryFound : program[entry]? = some (publicScalarBody profile scalar))
    (scalarFound : program[scalar]? = some body) (shaped : ScalarShaped body base vector small doubled specs)
    (disabled : body.profile.advSimd = false) (sse42 : body.profile.sse42 = true)
    (helper : SSEHelperContract program vector) (smallContract : PortableSmallContract program small) :
    WrappingBinaryContract (· + ·) program entry := by
  apply add_contract_of_scalar program entry scalar profile entryFound noAvx2
  intro memory left right output call
  simpa only [vector128Arguments, binaryArguments, List.cons_append, List.nil_append] using
    checked_scalar_contract program body scalar base vector small doubled specs scalarFound shaped helper smallContract
      disabled sse42 memory left right output 0 rfl call

#print axioms inlineSpecs_first
#print axioms inlineSpecs_words
#print axioms inline_carry_shaped
#print axioms inline_carry_helper_contract
#print axioms inline_carry_scalar_shaped
#print axioms checked_scalar_add
end UInt256Proof.Add.SSEShapes
