<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Nethermind.Int256">
      <HintPath>$(VerifiedAssembly)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireVerifiedAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VerifiedAssembly)')" Text="Supply VerifiedAssembly pointing to the tested production DLL." />
  </Target>
</Project>
