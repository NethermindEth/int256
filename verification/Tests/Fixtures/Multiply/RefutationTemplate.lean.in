import UInt256.Methods.Multiply.Calls
import UInt256.Methods.Multiply.Refutation
open CIL UInt256Model
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
namespace UInt256Proof.Multiply.Witness

def initial : Bytes := fun address => @INITIAL@

def observation := (invoke Extracted.program (executionBound Extracted.program Extracted.entryIndex)
  Extracted.entryIndex [.object @LEFT@, .object @RIGHT@, .object @OUTPUT@]
    (byteMemory initial)).map fun result => result.fst (.byte @ADDRESS@)

theorem observed : observation = some (some (.i8 (BitVec.ofNat 8 @ACTUAL@))) := by
  unfold observation
  simp only [invoke, cil_code, Option.bind_eq_bind, Option.bind_some, initFrame_plain]
  cil_execute_core read64, readBytes, byteMemory, initial, evalMemory, writeBytes, write, lowProduct, highProduct,
    eval_create256, eval_store256, unsafeAsRef, unsafeAdd, offsetValue with
      (first | cil_wide_product_call | cil_count_carry_call | cil_multiply_store_call)
  all_goals simp [*, writeBytes, store4, write]
  all_goals decide

theorem expected : writeBytes (byteMemory initial) @OUTPUT@
    (byteValue initial @LEFT@ * byteValue initial @RIGHT@).toNat 32 (.byte @ADDRESS@) =
    some (.i8 (BitVec.ofNat 8 @EXPECTED@)) := by decide

theorem refuted : ¬ Contract Extracted.program Extracted.entryIndex initial @LEFT@ @RIGHT@ @OUTPUT@ := by
  apply byte_observation_refuted Extracted.program Extracted.entryIndex
    (executionBound Extracted.program Extracted.entryIndex) initial @LEFT@
    @RIGHT@ @OUTPUT@ @ADDRESS@ (some (.i8 (BitVec.ofNat 8 @ACTUAL@))) observed
  rw [expected]
  decide

end UInt256Proof.Multiply.Witness
#print axioms UInt256Proof.Multiply.Witness.refuted
