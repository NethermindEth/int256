<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethermind.Int256</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <Target Name="CheckFixtureCase" BeforeTargets="CoreCompile"
      Condition="'$(FixtureCase)' != 'Baseline' And '$(FixtureCase)' != 'AlternativeOrder' And '$(FixtureCase)' != 'ExtractedHelper' And '$(FixtureCase)' != 'WrongCarry' And '$(FixtureCase)' != 'WrongCrossProduct' And '$(FixtureCase)' != 'WrongAliasing' And '$(FixtureCase)' != 'WrongHighLow' And '$(FixtureCase)' != 'WrongBmiHigh'">
    <Error Text="Unknown Multiply fixture case: $(FixtureCase)" />
  </Target>
  <Import Project="Fixtures.props" />
  <ItemGroup>
    <Compile Include="$(FixtureCase).cs" />
  </ItemGroup>
</Project>

