<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethermind.Int256</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="CheckFixtureCase" BeforeTargets="CoreCompile"
      Condition="'$(FixtureCase)' != 'Baseline' And '$(FixtureCase)' != 'ExpandedHardware' And '$(FixtureCase)' != 'ExtractedHelper' And '$(FixtureCase)' != 'Renamed' And '$(FixtureCase)' != 'ReversedStore' And '$(FixtureCase)' != 'WrongAliasing' And '$(FixtureCase)' != 'WrongCarry'">
    <Error Text="Unknown Add fixture case: $(FixtureCase)" />
  </Target>
  <Import Project="Fixtures.props" />
  <ItemGroup>
    <Compile Include="$(FixtureCase).cs" />
  </ItemGroup>
</Project>
