<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nethermind.Int256</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FixtureCase Condition="'$(FixtureCase)' == ''">Baseline</FixtureCase>
    <LeftCase>Lsh</LeftCase><RightCase>Rsh</RightCase>
    <LeftCase Condition="'$(FixtureCase)' == 'LshHelper' or '$(FixtureCase)' == 'LshWrongLane' or '$(FixtureCase)' == 'LshWrongCount' or '$(FixtureCase)' == 'LshEarlyStore'">$(FixtureCase)</LeftCase>
    <RightCase Condition="'$(FixtureCase)' == 'RshWrongDirection'">$(FixtureCase)</RightCase>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Support.cs" /><Compile Include="Storage.cs" />
    <Compile Include="$(LeftCase).cs" /><Compile Include="$(RightCase).cs" />
  </ItemGroup>
  <Target Name="ValidateFixtureCase" BeforeTargets="CoreCompile">
    <Error Condition="'$(FixtureCase)' != 'Baseline' and '$(FixtureCase)' != 'LshHelper' and '$(FixtureCase)' != 'LshWrongLane' and '$(FixtureCase)' != 'LshWrongCount' and '$(FixtureCase)' != 'LshEarlyStore' and '$(FixtureCase)' != 'RshWrongDirection'" Text="Unknown shift fixture case" />
  </Target>
</Project>
