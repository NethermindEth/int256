import Extracted
import UInt256.Methods.Shift.SafetyRefutation
namespace ShiftWitness
open CIL.Safety UInt256Model.Safety
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000
def memory : Memory := {
  allocations := fun id => if id = 0 then some {kind := .callerStack, layout := {size := 128, alignment := 1}} else none
  cells := fun id offset => ⟨if id = 0 ∧ offset = @INITIAL_OFFSET@ then 1 else 0, true⟩
  views := [⟨0, 0, 128, true, true⟩]
  nextIdentity := 1
}

theorem wellFormed : memory.WellFormed := by
  constructor
  · intro id allocation present
    by_cases h : id = 0
    · subst id
      simp [memory] at present
      subst allocation
      exact ⟨by decide, by simp [Allocation.WellFormed, nativeLimit]⟩
    · simp [memory, h] at present
  · simp [memory]

theorem call : CallingConditions Extracted.program memory [⟨0,0⟩] [] := by
  refine ⟨⟨wellFormed, ?_, ?_⟩, ?_⟩
  · intro input member
    simp only [List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at member
    subst input
    exact ⟨_, rfl⟩
  · intro output member; simp at member
  · change StaticWorldValid [] memory
    simp [StaticWorldValid, memory]


theorem refuted : ¬ UInt256Model.Safety.ReadOnlyScalarContract CIL.Value.i32
    (fun input count => .aggregate (numberBytes (UInt256Proof.Shift.result .@DIRECTION@ input count).toNat 32)) Extracted.program 0 := by
  apply UInt256Proof.Shift.checked_operator_refuted Extracted.program 0 256 .@DIRECTION@ memory ⟨0,0⟩ @COUNT@
    (.aggregate (numberBytes @ACTUAL@ 32)) call
  · rfl
  · decide
#print axioms refuted
end ShiftWitness
